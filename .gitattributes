* text=auto
*.sh text eol=lf
*.py text eol=lf
*.java text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf

# Original public samples are small enough for ordinary Git; no LFS dependency.
*.jpg -text
*.webp -text
*.mp4 -text
*.ttf -text

# Asset checksums are byte-exact, including text notices/provenance.
assets/** -text -eol
LICENSE text eol=lf
